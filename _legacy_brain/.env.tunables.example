# ── Genios runtime tunables ─────────────────────────────────────────────────
# Every value here is a valid deploy-time override for logic that previously
# had hardcoded lists or numbers. All have sensible defaults — set only the
# ones you actually want to change.
#
# Source of truth: app/tunables.py


# ── Broadcast / marketing sender detection ─────────────────────────────────
# Comma-separated local-part patterns that mark a sender as broadcast.
# Matched against the part before "@" in the email address.
# GENIOS_BROADCAST_LOCAL_PATTERNS=noreply,no-reply,notifications,info,newsletter,updates,mailer,promo,marketing,support,hello,team,vacancy,careers,jobs,contract.notes,billing,accounts,system

# Comma-separated domain fragments (matched against "@<fragment>." or ".<fragment>.").
# Useful for transactional mail providers and regional job boards.
# GENIOS_BROADCAST_DOMAINS=naukri,shine,luma-mail,sendgrid,mailgun,amazonses,mailchimp

# Behavioral threshold: if a contact has sent ≥ N messages and we never replied,
# they're flagged as broadcast even if the address looks human.
# GENIOS_BROADCAST_MIN_ONEWAY_COUNT=3


# ── Meeting-title topic extraction (fallback when LLM extractor skipped) ───
# JSON map — each key is a normalized topic, value is list of keyword aliases.
# GENIOS_MEETING_TITLE_TOPICS={"interview":["interview","screening"],"1:1":["1:1","1-on-1"]}

# Comma-separated stopwords to ignore when extracting fallback topic from title.
# GENIOS_TITLE_TOPIC_STOPWORDS=meeting,call,chat,sync,catch-up,with,and,the,a,an,for,re

# Minimum token length to consider as a topic (default 4).
# GENIOS_TITLE_TOPIC_MIN_LEN=4


# ── Already existing tunables (for reference) ──────────────────────────────
# LLM_TIMEOUT_SECONDS=30
# GENIOS_ENTITY_REPEAT_CAP=8
