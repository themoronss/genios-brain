# GeniOS Brain v2 — environment template
# Copy to .env and fill in. NEVER commit .env (it's in .gitignore).

# ── Infra ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/dbname
REDIS_URL=redis://default:pass@host:6379

# Public URL where Brain is reachable from internet (for inbound webhooks)
# Local dev: use ngrok, e.g. https://abc123.ngrok-free.app
GENIOS_PUBLIC_URL=

# ── Encryption (REQUIRED — customer secrets at-rest) ────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GENIOS_CRYPTO_MASTER_KEY=

# ── LLM keys (platform-level, our spend) ────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_SONNET_MODEL=claude-sonnet-4-6
GROQ_API_KEY=
OPENAI_API_KEY=

# ── Observability ───────────────────────────────────────────────────────────
SENTRY_DSN=

# PostHog analytics.
# Project write key (phc_...) — used by app/core/analytics.py to emit events.
POSTHOG_API_KEY=
# Event INGEST host — must match your project region (US: https://us.i.posthog.com).
POSTHOG_INGEST_HOST=https://eu.i.posthog.com
# Query/app API host — NOTE: no "i." — used by /v1/admin/metrics (US: https://us.posthog.com).
POSTHOG_HOST=https://eu.posthog.com
# Personal API key (phx_...) + project id — OPTIONAL: only to auto-compare
# /v1/admin/metrics against PostHog. Omit → metrics still work, no auto-compare.
POSTHOG_READ_KEY=
POSTHOG_PROJECT_ID=
# Shared secret protecting /v1/admin/metrics (exact MRR/ARR/NRR). REQUIRED for
# that endpoint (unset → 503). Generate: openssl rand -hex 32
ADMIN_METRICS_TOKEN=

# ── Environment ─────────────────────────────────────────────────────────────
GENIOS_ENV=development
LOG_LEVEL=INFO
