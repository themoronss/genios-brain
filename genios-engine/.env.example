# GeniOS Engine config — copy to .env and fill. All keys are GENIOS_-prefixed.
# .env is gitignored; NEVER commit real secrets. Empty values fall back to safe dev defaults.

GENIOS_ENV=dev

# ── storage (required for real mode) ───────────────────────────
# Supabase session-pooler URI (IPv4, port 5432). Empty = in-memory dev repos.
GENIOS_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── crypto (required when DATABASE_URL is set) ─────────────────
# Fernet key — generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GENIOS_CRYPTO_KEY=

# ── LLM (L2 extraction / L5 render) ────────────────────────────
GENIOS_ANTHROPIC_API_KEY=sk-ant-...
GENIOS_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── connectors (Composio: Gmail/Calendar/Notion/Drive) ─────────
GENIOS_COMPOSIO_API_KEY=
GENIOS_COMPOSIO_GMAIL_ACCOUNT=
GENIOS_COMPOSIO_WEBHOOK_SECRET=            # HMAC secret for inbound /webhooks/composio

# ── auth + cache (both optional; sensible dev defaults) ────────
GENIOS_JWT_SECRET=change-me-in-prod        # dashboard-session JWT signing
GENIOS_REDIS_URL=                          # rediss://… (Upstash) — empty = no-op NullCache
GENIOS_INTERNAL_TOKEN=                      # required to call cron endpoints (/context/sweep, /ingest/all)
GENIOS_CORS_ORIGINS=*                       # comma-separated dashboard origins in prod

# ── options ────────────────────────────────────────────────────
GENIOS_MASK_PHONE=false
GENIOS_ENABLE_L1_RELEVANCE=false
GENIOS_ENABLE_OCR=false                     # Tesseract binary needed if true; native text works without
