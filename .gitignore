# Test upload artifacts — the upload door writes here at runtime; a policy fixture
# committed by a test run is not source.
uploads/

# v1 leftovers and a stale partial copy of a SEPARATE product, both popped in from the
# old `conversation-work-backup` stash. genios-dashboard has its own git history one level up.
app/
genios-dashboard/

# macOS Finder metadata. Swept into ebf372e4 by a `git add -A`; never part of the product.
.DS_Store

# DigitalOcean buildpack switches to uv (and ignores requirements.txt) when uv.lock is present;
# pyproject.toml lists 9 of the 23 runtime deps, so a uv build ships without anthropic/composio.
uv.lock
