{
  "id": "csm_health",
  "version": "0.1.0",
  "requiredScopes": ["accounts:read"],
  "engineVersion": ">=2.0",
  "provides": {
    "rules": ["health"],
    "graphFragment": "knowledge/relationship_graph.json",
    "simulationTemplates": [],
    "artifacts": []
  },
  "goldenSet": "evaluator.py",
  "rule_metadata": {
    "csm_renewal_at_risk": {
      "title": "Renewal at risk — executive check-in needed",
      "priority": "high",
      "tunable_knobs": [
        {"fact_predicate": "days_to_renewal", "op": "<=", "default_threshold": 60}
      ]
    },
    "csm_nps_detractor_high_mrr": {
      "title": "Detractor on a paying account — save call",
      "priority": "high",
      "tunable_knobs": [
        {"fact_predicate": "nps_score", "op": "<", "default_threshold": 7}
      ]
    },
    "csm_dormant_paying_account": {
      "title": "Paying account hasn't logged in — friendly check",
      "priority": "medium",
      "tunable_knobs": [
        {"fact_predicate": "days_since_last_login", "op": ">", "default_threshold": 14}
      ]
    },
    "csm_ticket_backlog": {
      "title": "Open ticket backlog — escalate",
      "priority": "high",
      "tunable_knobs": [
        {"fact_predicate": "open_tickets", "op": ">=", "default_threshold": 5}
      ]
    },
    "csm_usage_drop": {
      "title": "Active usage dropped sharply — investigate",
      "priority": "medium",
      "tunable_knobs": [
        {"fact_predicate": "usage_drop_pct_30d", "op": ">", "default_threshold": 40}
      ]
    }
  }
}
